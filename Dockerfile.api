FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements/api.txt requirements/api.txt
RUN pip install --no-cache-dir -r requirements/api.txt

# The package is needed at load time: the pickled pipeline references creditguard.features.
COPY creditguard/ creditguard/
COPY artifacts/ artifacts/

RUN useradd --create-home appuser
USER appuser

EXPOSE 8000
# Cloud hosts such as Render inject PORT; locally it falls back to 8000.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import os,urllib.request,sys; p=os.environ.get('PORT','8000'); sys.exit(0 if urllib.request.urlopen('http://localhost:'+p+'/health', timeout=4).status == 200 else 1)"

CMD ["sh", "-c", "uvicorn creditguard.api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
