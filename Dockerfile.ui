FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements/ui.txt requirements/ui.txt
RUN pip install --no-cache-dir -r requirements/ui.txt

COPY ui/ ui/

RUN useradd --create-home appuser
USER appuser

ENV API_URL=http://api:8000
EXPOSE 8501
# Cloud hosts such as Render inject PORT; locally it falls back to 8501.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import os,urllib.request,sys; p=os.environ.get('PORT','8501'); sys.exit(0 if urllib.request.urlopen('http://localhost:'+p+'/_stcore/health', timeout=4).status == 200 else 1)"

CMD ["sh", "-c", "streamlit run ui/app.py --server.port=${PORT:-8501} --server.address=0.0.0.0 --server.headless=true"]
